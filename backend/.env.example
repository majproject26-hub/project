# MongoDB Atlas Connection String
# Replace with your actual connection string from MongoDB Atlas:
# e.g.: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=shegu_lakehouse

# JWT Secret Key
SECRET_KEY=lakehouse-super-secret-cryptographic-jwt-key-2026

# Email Provider: Resend (Recommended HTTP REST API)
# Get your free key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP Fallback Email Configuration (for OTP delivery & password reset)
# For Gmail: Create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Lakehouse Cloud Security
SMTP_USE_TLS=true

